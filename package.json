		"test": "tsx --test tests/*.test.ts",
		"check": "tsc --noEmit && biome check . && pnpm test",
		"start": "dotenvx run -f .env.local -f .env --ignore=MISSING_ENV_FILE -- expo start -c",
		"prebuild": "dotenvx run -f .env.local -f .env --ignore=MISSING_ENV_FILE -- expo prebuild",
